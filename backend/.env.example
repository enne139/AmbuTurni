# Copia questo file in ".env" e personalizza i valori.
# Usato solo per lo sviluppo/test locale del backend da solo (docker-compose.yml
# in questa cartella): in produzione il binario gira dentro l'immagine web,
# vedi il Dockerfile alla radice del repo.

# Porta su cui ascolta l'API
PORT=3000

# Connessione a PostgreSQL (in docker-compose punta al servizio "db")
DATABASE_URL=postgres://ambulanza:CAMBIA_QUESTA_PASSWORD@db:5432/ambulanza

# Password del database (usata dal servizio postgres nel compose)
POSTGRES_PASSWORD=CAMBIA_QUESTA_PASSWORD

# Chiave segreta per firmare i token JWT: usa una stringa lunga e casuale
JWT_SECRET=metti-una-chiave-lunga-e-casuale
# Durata del token: numero di giorni con suffisso "d" (es. 30d) oppure
# qualunque durata Go (es. 720h, 12h)
TOKEN_TTL=30d

# Utente amministratore della pagina /admin, creato al primo avvio
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CAMBIA_QUESTA_PASSWORD
